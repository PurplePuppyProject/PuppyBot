# Tokens that help libFuzzer find valid input, see fuzz/README.md. One dictionary serves all
# targets.

# The options of the command line, and the separator of the arguments.
"--version"
"--help"
"--config"
"--config="
"-V"
"-h"
"-c"
"\x00"

# The configuration file.
"[discord]"
"[log]"
"token-file"
"level"
"format"
"\"token\""
"\"text\""
"\"json\""
"\"debug\""
" = "
"\x0a"

# Files with secrets: line breaks at the end.
"\x0d\x0a"

# Interactions, as JSON from Discord's gateway. The seeds in seeds/interaction hold whole ones.
"\"id\""
"\"application_id\""
"\"type\""
"\"version\""
"\"locale\""
"\"guild_id\""
"\"data\""
"\"name\""
"\"options\""
"\"info\""
"\"de\""
"\"en-US\""
"\"1\""
"null"
"true"
"\":\""
"\",\""
"{}"
"[]"
