# Tokens that help libFuzzer find valid input, see fuzz/README.md. One dictionary serves all
# targets.

# The options of the command line, and the separator of the arguments.
"--version"
"--help"
"--config"
"--config="
"-V"
"-h"
"-c"
"\x00"

# The configuration file.
"[discord]"
"[log]"
"token-file"
"level"
"format"
"\"token\""
"\"text\""
"\"json\""
"\"debug\""
" = "
"\x0a"

# Polls.
"|"
" | "
"?"

# Dice.
"d"
"w"
"kh"
"kl"
"k"
"+"
"-"
"100"
"1000"
"20"

# Text commands: the prefix on the first line, and the message, see fuzz/README.md.
"<@1234>"
"<@!1234>"
"help"
"hilfe"
"pb?"

# Files with secrets: line breaks at the end.
"\x0d\x0a"

# Interactions, as JSON from Discord's gateway. The seeds in seeds/interaction hold whole ones.
"\"id\""
"\"application_id\""
"\"type\""
"\"version\""
"\"locale\""
"\"guild_id\""
"\"data\""
"\"name\""
"\"options\""
"\"info\""
"\"settings\""
"\"language\""
"\"to\""
"\"value\""
"\"member\""
"\"permissions\""
"\"32\""
"\"en\""
"\"de\""
"\"en-US\""
"\"1\""
"null"
"true"
"\":\""
"\",\""
"{}"
"[]"

# The answers of GitHub's API.
"\"full_name\""
"\"private\""
"\"default_branch\""
"\"sha\""
"\"commit\""
"\"message\""
"\"author\""
"\"login\""
"\"name\""
"\"id\""
"\"tag_name\""
"\"draft\""
